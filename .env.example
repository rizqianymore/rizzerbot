# ==============================================================================
# RIZZER BOT - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi `.env` lalu sesuaikan nilainya:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI SERVICES CONFIGURATION
# ------------------------------------------------------------------------------
# DeepSeek Web Token / Cookie (Diperlukan jika menggunakan plugin .deepseek / gateway)
# Dapatkan dari cookie `userToken` di deepseek.com
DEEPSEEK_COOKIE_TOKEN=

# Token alternatif DeepSeek API resmi (opsional jika menggunakan API resmi)
DEEPSEEK_API_KEY=

# Google Gemini API Key (Opsional untuk fitur aipro / AI fallback)
GEMINI_API_KEY=

# OpenAI API Key (Opsional untuk fitur aiChat GPT fallback)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. MEDIA & SCRAPER SERVICES
# ------------------------------------------------------------------------------
# Cobalt Tools API Key (Opsional jika instance Cobalt memerlukan auth/token khusus)
COBALT_API_KEY=

# ------------------------------------------------------------------------------
# 3. DATABASE & STORAGE OVERRIDE (OPSIONAL)
# Biarkan kosong untuk menggunakan path default database di project
# ------------------------------------------------------------------------------
RIZZER_DB_PATH=
RIZZER_USERS_PATH=
