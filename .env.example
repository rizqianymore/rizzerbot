DEEPSEEK_COOKIE_TOKEN=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# Opsional: model Gemini (default: gemini-2.0-flash). Dapatkan key di https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-2.0-flash
# Opsional: provider gratis tambahan (tanpa ini pun .ai tetap jalan via scraping).# GROQ_API_KEY= gratis di https://console.groq.com/keys (tercepat, Llama 70B)
# OPENROUTER_API_KEY= gratis di https://openrouter.ai/keys (27+ model :free)
# CEREBRAS_API_KEY= gratis di https://cloud.cerebras.ai (cepat, Llama 70B)
# MISTRAL_API_KEY= gratis di https://console.mistral.ai (1B token/bulan)
# GITHUB_TOKEN= gratis di https://github.com/settings/tokens (GPT-4o, DeepSeek-R1, Llama)
# NVIDIA_API_KEY= gratis di https://build.nvidia.com (Llama 70B, Qwen 235B)
# Opsional: batas waktu AI per provider & seluruh rantai (ms).
# AI_SOURCE_TIMEOUT_MS=30000
# AI_CHAIN_TIMEOUT_MS=120000
OCRSPACE_API_KEY=
# VirusTotal gratis: daftar di https://www.virustotal.com/ → profil → API key (limit 500/hari, 4/menit).
# VT_API_KEY=
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=web_unlocker2
# Opsional: domain yang selalu lewat Bright Data duluan (koma, tanpa https).
# Contoh: BRIGHTDATA_FIRST_HOSTS=bloomberg.com,query1.finance.yahoo.com
BRIGHTDATA_FIRST_HOSTS=
# Opsional: 0 = matikan semua jalur Bright Data (langsung direct).
# BRIGHTDATA_ENABLED=1
# Opsional: geo Unlocker (kode negara ISO, cth ID).
# BRIGHTDATA_COUNTRY=
# Opsional: proxy Bright Data untuk media/binary & engine yt-dlp.
# Isi URL lengkap, atau cukup CUSTOMER + PASSWORD (zone diambil dari BRIGHTDATA_ZONE).
# BRIGHTDATA_PROXY=http://brd-customer-<customer>-zone-<zone>:<password>@brd.superproxy.io:44445
# BRIGHTDATA_CUSTOMER=
# BRIGHTDATA_PROXY_PASSWORD=
SISWA_API_URL=
# --- Telkom Schools / DigitS (presensi siswa, whitelist consent) ---
# SEMUA OPSIONAL. Cara paling simpel: .telkom <nis> <password> (siswa absen sendiri).
# Password default TIDAK didukung (tidak ada kredensial orang lain yang dipakai).
# 1) (opsional) Daftarkan NIS + consent: .telkomconsent add <nis> [nomor_wa_siswa]
# 2) (opsional) Simpan password siswa Sendiri di vault (JANGAN di kode/chat/log):
#    TELKOM_STUDENT_PASSWORDS={"539241249":"password-asli-siswa"}
#    TELKOM_PW_539241249=password-asli-siswa
#    TELKOM_VAULT_FILE=/path/luar/repo/vault.json   (JSON {"<nis>":"password"} atau teks "<nis>:password")
# Endpoint API, hash, dan proteksi Cloudflare TIDAK perlu dikonfigurasi manual:
# bot mendeteksi sendiri dari aplikasi resmi (cache 24 jam di database/telkom/endpoints.json).
# Jendela absen (WIB) dipakai sebagai prioritas jenis absen, quota per NIS per hari:
# TELKOM_WINDOW_DATANG=05:30-08:00
# TELKOM_WINDOW_PULANG=14:30-16:30
# TELKOM_DAILY_LIMIT=3
# --- Termux / lingkungan terbatas (opsional) ---
# 1 = matikan fitur browser (hemat RAM, wajib bila tanpa Chromium).
# BROWSER_DISABLED=
# Path ffmpeg/chrome kustom bila tidak terdeteksi otomatis.
# FFMPEG_PATH=
# CHROME_PATH=
# Path yt-dlp kustom (mis. hasil `pip install yt-dlp`).
# YTDLP_PATH=
# --- Backup otomatis ke owner (opt-in, default mati) ---
# BACKUP_TO_OWNER=1
# BACKUP_INTERVAL_HOURS=24
# --- Health endpoint untuk monitoring (opt-in, default mati) ---
# HEALTH_PORT=3001
# HEALTH_HOST=127.0.0.1
