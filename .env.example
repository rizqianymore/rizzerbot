DEEPSEEK_COOKIE_TOKEN=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# Opsional: model Gemini (default: gemini-2.0-flash). Dapatkan key di https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-2.0-flash
# Opsional: provider gratis tambahan (tanpa ini pun .ai tetap jalan via scraping).
# GROQ_API_KEY= gratis di https://console.groq.com/keys (tercepat, Llama 70B)
# OPENROUTER_API_KEY= gratis di https://openrouter.ai/keys (27+ model :free)
# CEREBRAS_API_KEY= gratis di https://cloud.cerebras.ai (cepat, Llama 70B)
# MISTRAL_API_KEY= gratis di https://console.mistral.ai (1B token/bulan)
# GITHUB_TOKEN= gratis di https://github.com/settings/tokens (GPT-4o, DeepSeek-R1, Llama)
# NVIDIA_API_KEY= gratis di https://build.nvidia.com (Llama 70B, Qwen 235B)
OCRSPACE_API_KEY=
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=web_unlocker2
# Opsional: domain yang selalu lewat Bright Data duluan (koma, tanpa https).
# Contoh: BRIGHTDATA_FIRST_HOSTS=bloomberg.com,query1.finance.yahoo.com
BRIGHTDATA_FIRST_HOSTS=
# Opsional: 0 = matikan semua jalur Bright Data (langsung direct).
# BRIGHTDATA_ENABLED=1
# Opsional: geo Unlocker (kode negara ISO, cth ID).
# BRIGHTDATA_COUNTRY=
SISWA_API_URL=
# --- Termux / lingkungan terbatas (opsional) ---
# 1 = matikan fitur browser (hemat RAM, wajib bila tanpa Chromium).
# BROWSER_DISABLED=
# Path ffmpeg/chrome kustom bila tidak terdeteksi otomatis.
# FFMPEG_PATH=
# CHROME_PATH=
# Path yt-dlp kustom (mis. hasil `pip install yt-dlp`).
# YTDLP_PATH=
