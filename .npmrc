# Keamanan instalasi dependensi RizzerBot.
# - package-lock selalu ditulis agar hasil install reproduksibel & bisa diaudit.
# - audit gagal (non-zero exit) bila ada vuln >= moderate: dipakai oleh
#   `npm run security:audit` di CI / sebelum deploy.
# - fund nonaktif agar `npm install` tidak mengeksekusi pesan pasca-install
#   yang tidak perlu (mengurangi noise + permukaan sosial-engineering).
audit-level=moderate
fund=false
package-lock=true
