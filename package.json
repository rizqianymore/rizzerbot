{
  "name": "rizzerbot",
  "version": "1.0.0",
  "description": "Professional and Modular WhatsApp Bot built with Baileys",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "bun run index.js",
    "start:node": "node index.js",
    "start:termux": "BROWSER_DISABLED=1 node index.js",
    "setup:termux": "bash scripts/termux-setup.sh",
    "termux:run": "bash scripts/termux-run.sh",
    "update": "bash scripts/update.sh",
    "test": "node scripts/smoke.js",
    "test:telkom": "node scripts/smoke-telkom.js",
    "telkom:env": "node scripts/telkom-env.js",
    "telkom:net": "node scripts/telkom-net.js",
    "telkom:live": "node scripts/telkom-live.js",
    "doctor": "node scripts/doctor.js",
    "fast": "node scripts/fast-nonbug.js --dry-run",
    "fast:apply": "node scripts/fast-nonbug.js --apply",
    "turbo": "node scripts/turbo-traffic.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs rizzerbot",
    "pm2:monit": "pm2 monit",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "security:check": "npm audit --audit-level=moderate && npm outdated",
    "clean:comments": "node scripts/clean-comments.js",
    "clean:comments:dry": "node scripts/clean-comments.js --dry-run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@napi-rs/canvas": "^1.0.9",
    "axios": "^1.20.0",
    "baileys": "7.0.0-rc14",
    "https-proxy-agent": "^7.0.6",
    "ourin-baileys": "^9.0.21",
    "parse5": "^8.0.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.1.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "tesseract.js": "^7.0.0"
  },
  "optionalDependencies": {
    "jsqr": "^1.4.0",
    "puppeteer": "^25.9.0",
    "puppeteer-core": "^25.13.0",
    "sharp": "^0.35.5",
    "zxing-wasm": "^3.1.6"
  },
  "overrides": {
    "axios": "^1.20.0",
    "image-size": "^2.0.4",
    "sharp": "^0.35.5",
    "@hapi/boom": "^10.0.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10"
  }
}
